{
  "name": "symphony-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript reimplementation of OpenAI Symphony — agent orchestration protocol + runtime (M0 scaffold)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "gate": "npm run typecheck && npm test && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript-eslint": "^8.8.0"
  }
}