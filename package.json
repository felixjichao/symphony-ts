{
  "name": "symphony-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript implementation of OpenAI Symphony (official SPEC.md) — long-running orchestrator that runs coding agents against issue-tracker work",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "docs:check": "node scripts/docs-check.mjs",
    "dogfood:github": "node apps/cli/dist/bin/symphony.js dogfood github",
    "gate": "npm run typecheck && npm test && npm run lint && npm run docs:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "overrides": {
    "typescript": "^5.6.2"
  }
}