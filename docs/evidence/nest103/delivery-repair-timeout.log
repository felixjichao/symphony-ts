export function add(a, b) {
  return a + b;
}

export function sortedCopy_nest103_20261010(values) {
  return values.sort((a, b) => a - b);
}

export function subtract_a8265c25fa(a, b) {
  return a - b;
}

export function subtract_810a38ecc6(a, b) {
  return a - b;
